# Shuttle request endpoint — copy to .env.local for local `vercel dev`, and set
# the same names in Vercel (Project > Settings > Environment Variables).
# Never commit real values.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Who receives a shuttle request. Comma-separated, no spaces needed.
SHUTTLE_TO=sanshia@goldenmilechrysler.ca,dhaanush@goldenmilechrysler.ca

# The "from" address. MUST be on a Resend-verified domain.
# onboarding@resend.dev works for testing but can only deliver to the
# Resend account owner's own email address.
SHUTTLE_FROM=onboarding@resend.dev

# Optional: CC a copy of every submission
SHUTTLE_CC=

# Optional: extra allowed browser origins, comma-separated.
# www.goldenmilechrysler.ca and goldenmilechrysler.ca are always allowed.
ALLOW_ORIGINS=
